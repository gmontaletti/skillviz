# Environment for the containerised CP4 imputation.
#
# Copy to a host file readable only by the account that runs the job:
#   sudo install -m 0600 -o monty -g monty postgres.env.example /etc/skillviz/postgres.env
#   sudoedit /etc/skillviz/postgres.env
#
# Passed with `docker run --env-file`. Never bake this into an image.
# Runtime paths (IMPUTE_LOCK_DIR) live in the Dockerfile, not here.

# 1. Connection ---------------------------------------------------------------
# PG_* is the canonical naming across the ecosystem; the script also accepts
# the POSTGRES_* aliases used by container/.Renviron and Docker convention.
PG_HOST=psiflariapostgres.postgres.database.azure.com
PG_PORT=5432
PG_DBNAME=postgres
PG_USER=
PG_PASSWORD=

# Azure Postgres requires TLS.
PGSSLMODE=require

# 2. Target -------------------------------------------------------------------
IMPUTE_TARGET_SCHEMA=staging
IMPUTE_TARGET_TABLE=gm_cp4_imputed

# 3. Scope --------------------------------------------------------------------
# Months of history to read. 24 matches the validated regime.
IMPUTE_WINDOW_MONTHS=24

# Per-ESCO-group training cap. Groups above it are subsampled by a
# deterministic stride, so exceeding it costs training data but not
# reproducibility; the job logs how many groups are affected. The cap does fire
# on 24 months (ESCO group 5223 carries ~52.7k labelled rows). Raising it uses
# those groups whole at proportionally higher memory.
IMPUTE_MAX_TRAIN=50000

# Elements in the dense test x train similarity block. Each batch holds three
# such matrices, so peak memory is roughly 24 bytes per element. The package
# default of 2e8 (~4.8 GB) OOM-kills an 8 GB container on the 24-month window
# with exit code 137; 2.5e7 costs ~600 MB. Lowering it only splits the work
# into more batches -- every test row is scored independently, so results are
# identical. Raise it if the container has plenty of RAM.
IMPUTE_DENSE_BUDGET=2.5e7

# Missing months at or below this run incrementally; above it, a full rebuild.
IMPUTE_MAX_INCREMENTAL=3

# 4. Model --------------------------------------------------------------------
# Defaults match skillviz_workflow/_targets.R.
IMPUTE_K=7
IMPUTE_SECTOR_BOOST=5

# Legacy k-NN rescue for rows with no idesco_level_4. Ignored while IMPUTE_XGB
# is on, because those rows belong to the xgboost path instead; kept so the old
# behaviour is still reachable with IMPUTE_XGB=0.
IMPUTE_RESCUE=1
IMPUTE_RESCUE_K=10
IMPUTE_RESCUE_MAX_TRAIN=400000

# 5. ESCO-less rows: one-hot + xgboost -----------------------------------------
# Each segment gets the model that wins on it. Where an ESCO code exists the
# k-NN wins, because restricting candidates to the codes observed for that exact
# occupation beats anything the covariates can do. Where none exists that
# restriction is unavailable and the covariates -- city, sector, source,
# contract, education, salary -- win instead (77.5% vs 66.8% CP3 when measured).
# This is also the only path that can classify a posting with no skills at all.
#
# It predicts CP5 directly, like the k-NN, so its rows carry a genuine level-4
# code rather than a level-3 one padded into level-4 shape.
#
# vtreat was removed, not merely bypassed. Measured over a 3-month temporal
# holdout on the 42,530 labelled ESCO-less rows
# (skillviz_workflow/run_cp5_xgboost_no_esco.R), impact coding is both slower
# and less accurate than a plain one-hot:
#     vtreat  -> CP3   736s   80.09%
#     one-hot -> CP3    21s   81.34%
#     vtreat  -> CP5  2953s   75.44%
#     one-hot -> CP5    35s   76.36%
# vtreat builds a DENSE frame whose width grows with the class count, which is
# why level 5 was previously believed impossible here; one-hot stays sparse and
# costs the same 1,531 columns whether there are 56 classes or 102.
IMPUTE_XGB=1
# CP5 codes with fewer labelled examples than this cannot be learned and are
# folded into an "other" bucket, whose rows are then left unimputed rather than
# guessed into a common class.
IMPUTE_XGB_RARE_MIN=30
IMPUTE_XGB_ROUNDS=400
IMPUTE_SEED=42

# 6. CP2021 level 5 -----------------------------------------------------------
# There is no switch here, because level 5 is the model rather than an addition
# to it. One k-NN pass votes at level 5 with the candidate space restricted on
# idesco_level_5, and the level-4 column is read off by truncation.
#
# Why one pass and not two. Truncating the level-5 argmax reproduces the level-4
# argmax to +0.004 pp contemporaneously and +0.02 pp walk-forward, changing 0.07%
# of predictions -- two orders of magnitude under the 0.244 pp noise floor. The
# neighbour search is ~98.6% of the runtime, so a second pass would nearly double
# the cost to re-derive the same answer. It also removes a failure mode: voting
# the levels independently let them disagree, and a disagreeing level-5 code had
# to be discarded. Under truncation the hierarchy holds by construction.
#
# Why level 5 restricts better than level 4. Validated walk-forward over the last
# 6 months (skillviz_workflow/run_cp5_restrictor_temporal.R): +3.95 pp at level 5
# and +3.81 pp at level 4, positive in 6 months of 6, coverage cost +0.04 pp, and
# better calibrated than the level-4 restrictor (ECE -0.81 pp). It is also
# cheaper -- 541s against 772s, and 5.64 GB peak against 6.41 GB -- because 2,714
# small groups do less dense work than 399 large ones.
#
# Coverage: the ~13% of announcements carrying idesco_level_5 = 'Unclassifiable'
# have no ESCO code at any level and cannot be restricted, so they go to the
# xgboost path in section 5 -- which now also predicts at level 5, so they are
# no longer confined to level-3 precision. Only rows whose predicted class fell
# into the rare-class bucket are left without a code.

# 7. Safety -------------------------------------------------------------------
# Read, decide, impute and reconcile, then write nothing.
IMPUTE_DRY_RUN=0

# The run mode is decided by comparing months, so it cannot tell that the model
# or routing changed -- only that data did. Set this to force a full rebuild
# after a model change. The write is still an atomic swap, so the live table is
# replaced only once the new one is complete.
IMPUTE_FORCE_FULL=0
