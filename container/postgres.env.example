# Environment for the containerised CP4 imputation.
#
# Copy to a host file readable only by the account that runs the job:
#   sudo install -m 0600 -o monty -g monty postgres.env.example /etc/skillviz/postgres.env
#   sudoedit /etc/skillviz/postgres.env
#
# Passed with `docker run --env-file`. Never bake this into an image.
# Runtime paths (IMPUTE_LOCK_DIR) live in the Dockerfile, not here.

# 1. Connection ---------------------------------------------------------------
# PG_* is the canonical naming across the ecosystem; the script also accepts
# the POSTGRES_* aliases used by container/.Renviron and Docker convention.
PG_HOST=psiflariapostgres.postgres.database.azure.com
PG_PORT=5432
PG_DBNAME=postgres
PG_USER=
PG_PASSWORD=

# Azure Postgres requires TLS.
PGSSLMODE=require

# 2. Target -------------------------------------------------------------------
IMPUTE_TARGET_SCHEMA=staging
IMPUTE_TARGET_TABLE=gm_cp4_imputed

# 3. Scope --------------------------------------------------------------------
# Months of history to read. 24 matches the validated regime.
IMPUTE_WINDOW_MONTHS=24

# Per-ESCO-group training cap. Groups above it are subsampled by a
# deterministic stride, so exceeding it costs training data but not
# reproducibility; the job logs how many groups are affected. The cap does fire
# on 24 months (ESCO group 5223 carries ~52.7k labelled rows). Raising it uses
# those groups whole at proportionally higher memory.
IMPUTE_MAX_TRAIN=50000

# Missing months at or below this run incrementally; above it, a full rebuild.
IMPUTE_MAX_INCREMENTAL=3

# 4. Model --------------------------------------------------------------------
# Defaults match skillviz_workflow/_targets.R.
IMPUTE_K=7
IMPUTE_SECTOR_BOOST=5

# Legacy k-NN rescue for rows with no idesco_level_4. Ignored while IMPUTE_XGB
# is on, because those rows belong to the xgboost path instead; kept so the old
# behaviour is still reachable with IMPUTE_XGB=0.
IMPUTE_RESCUE=1
IMPUTE_RESCUE_K=10
IMPUTE_RESCUE_MAX_TRAIN=400000

# 5. ESCO-less rows: vtreat + xgboost ----------------------------------------
# Each segment gets the model that wins on it. Measured on 60,002 held-out rows
# (CP3): where an ESCO code exists the k-NN wins 88.3% vs 85.0%, because its
# exact candidate-set restriction beats impact-coded ESCO; where none exists it
# loses 66.8% vs 77.5%. So the k-NN keeps the ESCO rows and xgboost takes the
# rest. Turning this off reverts those rows to the k-NN rescue.
IMPUTE_XGB=1
# CP3 codes with fewer labelled examples than this cannot be learned and are
# folded into an "other" bucket, whose rows are then left unimputed.
IMPUTE_XGB_RARE_MIN=30
IMPUTE_XGB_ROUNDS=400
# The vtreat recipe is fitted on data up to this month only.
IMPUTE_XGB_PERIOD_A_END=202412
IMPUTE_SEED=42

# 5. Safety -------------------------------------------------------------------
# Read, decide, impute and reconcile, then write nothing.
IMPUTE_DRY_RUN=0

# The run mode is decided by comparing months, so it cannot tell that the model
# or routing changed -- only that data did. Set this to force a full rebuild
# after a model change. The write is still an atomic swap, so the live table is
# replaced only once the new one is complete.
IMPUTE_FORCE_FULL=0
